<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://material.com/approval">

  <process id="sequentialApproval" name="模板中文名" isExecutable="true">
    <startEvent id="start" name="提交申请"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="firstApprove"/>
    <userTask id="firstApprove" name="一级审批" flowable:candidateGroups="ROLE_ADMIN"/>
    <sequenceFlow id="flow2" sourceRef="firstApprove" targetRef="secondApprove"/>
    <userTask id="secondApprove" name="二级审批" flowable:candidateGroups="ROLE_ADMIN"/>
    <sequenceFlow id="flow3" sourceRef="secondApprove" targetRef="end"/>
    <endEvent id="end" name="审批结束"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_sequentialApproval">
    <bpmndi:BPMNPlane id="BPMNPlane_sequentialApproval" bpmnElement="sequentialApproval">
      <bpmndi:BPMNShape id="start_sh" bpmnElement="start">
        <omgdc:Bounds x="155" y="161" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="firstApprove_sh" bpmnElement="firstApprove" isHorizontal="true">
        <omgdc:Bounds x="250" y="139" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="secondApprove_sh" bpmnElement="secondApprove" isHorizontal="true">
        <omgdc:Bounds x="410" y="139" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_sh" bpmnElement="end">
        <omgdc:Bounds x="570" y="161" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_eg" bpmnElement="flow1">
        <omgdi:waypoint x="191" y="179"/>
        <omgdi:waypoint x="250" y="179"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_eg" bpmnElement="flow2">
        <omgdi:waypoint x="350" y="179"/>
        <omgdi:waypoint x="410" y="179"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_eg" bpmnElement="flow3">
        <omgdi:waypoint x="510" y="179"/>
        <omgdi:waypoint x="570" y="179"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
